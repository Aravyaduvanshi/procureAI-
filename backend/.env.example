# ==============================================================================
# ProcureAI Backend Environment Configuration Template
# Copy this file to .env in backend/ for local configuration
# NEVER commit real production API keys or credentials to version control.
# ==============================================================================

# Core Ports & URLs
PORT=8000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Microservice Service URLs (Default localhost ports)
AUTH_SERVICE_URL=http://127.0.0.1:8001
SUPPLIER_SERVICE_URL=http://127.0.0.1:8002
REQUIREMENT_SERVICE_URL=http://127.0.0.1:8003
VENDOR_RATING_SERVICE_URL=http://127.0.0.1:8004
MATCHING_SERVICE_URL=http://127.0.0.1:8005
APPROVAL_SERVICE_URL=http://127.0.0.1:8006
NEGOTIATION_SERVICE_URL=http://127.0.0.1:8007
COMMUNICATION_SERVICE_URL=http://127.0.0.1:8008
BILLING_SERVICE_URL=http://127.0.0.1:8009

# Redis Cache & Session Store
# Points to local Redis container (default port 6379)
REDIS_URL=redis://localhost:6379

# Durable Database Persistence (PostgreSQL)
# When set, backend uses PostgreSQL. When empty, backend automatically uses
# the local file-backed durable repository in backend/data/store/ for zero-setup local dev.
DATABASE_URL=postgresql://procureai:procureai_dev_password@localhost:5432/procureai

# MongoDB (Optional for legacy Firebase User auth model)
MONGOOSE_URI=mongodb://localhost:27017/procureai_auth

# AI Configuration (Gemini / LLM Provider)
# Set ENABLE_AI=true to connect to real LLM. Defaults to false (deterministic rule-based local mode).
ENABLE_AI=false
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Communication & Email Dispatch
# External outbound sending is strictly disabled by default for safety.
ENABLE_EXTERNAL_EMAIL=false
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=procurement@example.com

# Security & Sessions
JWT_SECRET=procureai_dev_secret_key_change_in_production
SESSION_SECRET=procureai_session_cookie_dev_secret_key
