# ==============================================================================
# ProcureAI Backend Environment Configuration Template
# Copy this file to .env in backend/ for local configuration
# NEVER commit real production API keys or credentials to version control.
# ==============================================================================

# Core Ports & URLs
PORT=8000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
REALTIME_PORT=8000

# Microservice Service URLs (Default localhost ports)
GATEWAY_PORT=8000
AUTH_PORT=8001
SUPPLIER_PORT=8002
REQUIREMENT_PORT=8003
RATING_PORT=8004
MATCHING_PORT=8005
APPROVAL_PORT=8006
NEGOTIATION_PORT=8007
COMMUNICATION_PORT=8008
BILLING_PORT=8009

AUTH_SERVICE_URL=http://127.0.0.1:8001
SUPPLIER_SERVICE_URL=http://127.0.0.1:8002
REQUIREMENT_SERVICE_URL=http://127.0.0.1:8003
VENDOR_RATING_SERVICE_URL=http://127.0.0.1:8004
MATCHING_SERVICE_URL=http://127.0.0.1:8005
APPROVAL_SERVICE_URL=http://127.0.0.1:8006
NEGOTIATION_SERVICE_URL=http://127.0.0.1:8007
COMMUNICATION_SERVICE_URL=http://127.0.0.1:8008
BILLING_SERVICE_URL=http://127.0.0.1:8009

# Redis Cache & Realtime Event Bus
REDIS_URL=redis://localhost:6379

# PostgreSQL Persistence Layer (MANDATORY Single Source of Truth)
# Application fails fast if DATABASE_URL is not set.
DATABASE_URL=postgresql://procureai:procureai_dev_password@localhost:5432/procureai

# AI & LLM Configuration
# Set ENABLE_AI=true to enable real LLM generation for negotiation messages.
ENABLE_AI=true
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-20b

# Negotiation Commercial Bounds
MAX_NEGOTIATION_ROUNDS=5

# Outbound Email Dispatch & Inbound Provider Integration
# Supports: mock, resend, sendgrid
EMAIL_PROVIDER=mock
ENABLE_EXTERNAL_EMAIL=false
EMAIL_API_KEY=
EMAIL_FROM=procurement@example.com

# Security & Sessions
JWT_SECRET=procureai_dev_secret_key_change_in_production
SESSION_SECRET=procureai_session_cookie_dev_secret_key
